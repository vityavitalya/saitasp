@model Item
@{
    ViewData["Title"] = "Добавить книгу";
}

<partial name="_CabinetMenu" />

<div class="form-box">
    <h1>Добавить книгу</h1>

    <form asp-controller="Cabinet" asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" />
            <span asp-validation-for="Title"></span>
        </div>

        <div class="form-group">
            <label asp-for="Author"></label>
            <input asp-for="Author" />
            <span asp-validation-for="Author"></span>
        </div>

        <div class="form-group">
            <label asp-for="Year"></label>
            <input asp-for="Year" />
            <span asp-validation-for="Year"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" rows="6"></textarea>
            <span asp-validation-for="Description"></span>
        </div>

        <button type="submit" class="btn">Сохранить</button>
        <a class="btn btn-light" asp-controller="Cabinet" asp-action="MyItems">Отмена</a>
    </form>
</div>
