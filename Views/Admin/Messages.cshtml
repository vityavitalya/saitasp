@model List<Message>
@{
    ViewData["Title"] = "Админка — сообщения";
}

<partial name="_AdminMenu" />

<h1>Сообщения из формы «Контакты»</h1>

@if (Model.Count == 0)
{
    <p>Сообщений пока нет.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <tr>
                <th>Дата</th>
                <th>Имя</th>
                <th>Email</th>
                <th>Сообщение</th>
            </tr>
            @foreach (Message message in Model)
            {
                <tr>
                    <td>@message.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@message.Name</td>
                    <td>@message.Email</td>
                    <td class="description">@message.Text</td>
                </tr>
            }
        </table>
    </div>
}
