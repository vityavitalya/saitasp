@model List<Item>
@{
    ViewData["Title"] = "Каталог";
}

<h1>Каталог книг</h1>

<form asp-controller="Items" asp-action="Index" method="get" class="search">
    <input type="text" name="search" value="@ViewBag.Search" placeholder="Название или автор" />
    <button type="submit" class="btn">Найти</button>
</form>

@if (ViewBag.Search != null)
{
    <p>
        Поиск «@ViewBag.Search»: найдено книг — @Model.Count.
        <a asp-controller="Items" asp-action="Index">Показать все</a>
    </p>
}

@if (Model.Count == 0)
{
    <p>Книг не найдено.</p>
}

<div class="cards">
    @foreach (Item item in Model)
    {
        <div class="card">
            <h3>@item.Title</h3>
            <div class="muted">@item.Author, @item.Year г.</div>
            <p class="card-text">@item.Description</p>
            <div class="muted">Добавил(а): @item.UserName</div>
            <a class="card-link" asp-controller="Items" asp-action="Details" asp-route-id="@item.Id">Подробнее →</a>
        </div>
    }
</div>
